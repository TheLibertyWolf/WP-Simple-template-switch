msgid "Permet aux utilisateurs autorisés de choisir leur thème WordPress depuis leur profil ou la barre d’administration."
msgstr "Permite que os utilizadores autorizados escolham o seu tema WordPress através do perfil ou da barra de administração."

msgid "WP Simple Template Switch : module indisponible (%s). Réinstallez le plugin."
msgstr "WP Simple Template Switch: módulo indisponível (%s). Reinstale o plugin."

msgid "Thème personnel"
msgstr "Tema pessoal"

msgid "Thème du site"
msgstr "Tema do site"

msgid "Thème par défaut du site (%s)"
msgstr "Tema predefinido do site (%s)"

msgid "Ce choix modifie uniquement le thème que cet utilisateur voit sur le site public."
msgstr "Esta escolha altera apenas o tema que este utilizador vê no site público."

msgid "Par défaut (%s)"
msgstr "Predefinido (%s)"

msgid "Thème : %s"
msgstr "Tema: %s"

msgid "Thème du site (%s)"
msgstr "Tema do site (%s)"

msgid "Vous n’êtes pas autorisé à choisir un thème."
msgstr "Não tem permissão para escolher um tema."

msgid "Accès refusé"
msgstr "Acesso negado"

msgid "Le thème demandé est indisponible."
msgstr "O tema solicitado não está disponível."

msgid "Thème indisponible"
msgstr "Tema indisponível"

msgid "WP Simple Template Switch"
msgstr "WP Simple Template Switch"

msgid "Template Switch"
msgstr "Mudança de tema"

msgid "Réglages"
msgstr "Definições"

msgid "Vous n’êtes pas autorisé à gérer ces réglages."
msgstr "Não tem permissão para gerir estas definições."

msgid "Autorisez des utilisateurs à tester un autre thème sans modifier le thème actif pour les autres visiteurs."
msgstr "Permita que os utilizadores testem outro tema sem alterar o tema ativo para os restantes visitantes."

msgid "Réglages enregistrés."
msgstr "Definições guardadas."

msgid "Activation et emplacements"
msgstr "Ativação e localizações"

msgid "Activer le choix d’un thème personnel"
msgstr "Ativar a escolha de um tema pessoal"

msgid "Afficher le sélecteur sur la page de profil"
msgstr "Mostrar o seletor na página de perfil"

msgid "Afficher le sélecteur dans la barre d’administration"
msgstr "Mostrar o seletor na barra de administração"

msgid "Qui peut choisir son thème ?"
msgstr "Quem pode escolher o seu tema?"

msgid "Tous les utilisateurs connectés"
msgstr "Todos os utilizadores com sessão iniciada"

msgid "Uniquement les rôles sélectionnés"
msgstr "Apenas as funções selecionadas"

msgid "Uniquement les utilisateurs sélectionnés"
msgstr "Apenas os utilizadores selecionados"

msgid "Rôles autorisés"
msgstr "Funções autorizadas"

msgid "Utilisateurs autorisés"
msgstr "Utilizadores autorizados"

msgid "Qui peut accéder à ces réglages ?"
msgstr "Quem pode aceder a estas definições?"

msgid "L’accès peut être accordé par rôle et/ou individuellement. Les super-administrateurs Multisite conservent toujours l’accès."
msgstr "O acesso pode ser concedido por função e/ou individualmente. Os superadministradores Multisite mantêm sempre o acesso."

msgid "Rôles gestionnaires"
msgstr "Funções de gestão"

msgid "Utilisateurs gestionnaires"
msgstr "Utilizadores gestores"

msgid "Si aucune entrée n’est cochée, votre propre compte sera conservé comme gestionnaire afin d’éviter un verrouillage."
msgstr "Se nenhuma opção for selecionada, a sua conta continuará como gestora para evitar um bloqueio."

msgid "Thèmes détectés"
msgstr "Temas detetados"

msgid "Les nouveaux thèmes installés apparaissent automatiquement dans les sélecteurs."
msgstr "Os novos temas instalados aparecem automaticamente nos seletores."

msgid "Enregistrer les réglages"
msgstr "Guardar definições"

msgid "État"
msgstr "Estado"

msgid "Choix personnel actif"
msgstr "Escolha pessoal ativa"

msgid "Choix personnel désactivé"
msgstr "Escolha pessoal desativada"

msgid "Le thème actif du site n’est jamais modifié par les choix personnels."
msgstr "O tema ativo do site nunca é alterado pelas escolhas pessoais."

msgid "Utilisation"
msgstr "Utilização"

msgid "Choisissez les utilisateurs ou rôles autorisés."
msgstr "Escolha os utilizadores ou funções autorizados."

msgid "Installez le thème à tester sans l’activer globalement."
msgstr "Instale o tema a testar sem o ativar globalmente."

msgid "Basculez depuis le profil ou la barre d’administration."
msgstr "Mude através do perfil ou da barra de administração."

msgid "Chaque préférence est enregistrée dans le profil WordPress de l’utilisateur."
msgstr "Cada preferência é guardada no perfil WordPress do utilizador."

msgid "Sécurité des accès"
msgstr "Segurança de acesso"

msgid "Les changements sont protégés par les nonces WordPress et contrôlés côté serveur."
msgstr "As alterações são protegidas por nonces do WordPress e verificadas no servidor."

msgid "Le dernier gestionnaire ne peut pas être supprimé accidentellement : le compte qui enregistre est conservé si nécessaire."
msgstr "O último gestor não pode ser removido acidentalmente: se necessário, a conta que guarda as definições é mantida."

msgid "Aptitude avancée"
msgstr "Capacidade avançada"

msgid "Pour déléguer l’accès avec un gestionnaire de rôles ou d’aptitudes, attribuez :"
msgstr "Para delegar o acesso com um gestor de funções ou capacidades, atribua:"

msgid "Cette aptitude est attribuée automatiquement au rôle Administrateur lors de l’activation. Elle s’ajoute aux rôles et utilisateurs sélectionnés dans cette page."
msgstr "Esta capacidade é atribuída automaticamente à função Administrador durante a ativação. É adicionada às funções e aos utilizadores selecionados nesta página."

msgid "Auteur"
msgstr "Autor"

msgid "Voir le projet sur GitHub"
msgstr "Ver o projeto no GitHub"

#, php-format
msgid "%d thème détecté"
msgid_plural "%d thèmes détectés"
msgstr[0] "%d tema detetado"
msgstr[1] "%d temas detetados"
